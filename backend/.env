RAW_DATA_PATH=./raptor-rag/data/raw_data
EXTRACTED_DATA_PATH=./raptor-rag/data/extracted_data

ESSENTIALS_PATH=./raptor-rag/essentials
HIERARCHY_STORE_PATH=./raptor-rag/essentials/summary_tree.json

OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text:latest
OLLAMA_SUMMARY_MODEL=qwen2.5:7b
OLLAMA_LLM_RESPONSE_MODEL=qwen2.5:7b

OLLAMA_LLM_RESPONSE_CONFIG={"model":"qwen2.5:7b","temperature":0.2,"top_p":0.9,"top_k":40,"repeat_penalty":1.1,"max_context_length":8000,"default_top_k_root":5,"default_top_k_children":2}

UMAP_N_NEIGHBORS=15
UMAP_N_COMPONENTS=2
CLUSTER_DIVISOR=3
CLUSTERING_ALGO=kmeans
MAX_CLUSTER_SIZE=5

MAX_RETRIEVED_CHUNKS=5

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_GRADE_MODEL=qwen2.5:7b
MAX_FOLLOWUPS_PER_TOPIC=3
